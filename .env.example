# =====================================================================
# Startup Trainer (существующий тренажёр)
# =====================================================================
OPENAI_API_KEY=                 # проектный ключ с лимитом расходов, не личный
OPENAI_MODEL=gpt-5.6
INVITE_CODE=
# MOS-1 (#52): вход только по Google OAuth + allowlist (ADMIN_KEY удалён). Реальные значения сюда НЕ класть.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=                 # openssl rand -hex 32; обязателен при APP_ENV=staging|production
APP_ENV=
TRUSTED_PROXY_COUNT=0           # число доверенных прокси перед приложением (Render: 1); 0 — X-Forwarded-For игнорируется
AUTH_ALLOWLIST=                 # email:role[:scope], через запятую. Роли: owner, fund_staff, investor, founder, ...
AUTH_REDIRECT_URI=              # опц.; по умолчанию <host>/auth/callback
SESSION_DATABASE_URL=           # на Render — PostgreSQL (или DATABASE_URL от Render)
SESSION_RETENTION_DAYS=30
TRAINER_EVENT_WEBHOOK=
WEBHOOK_TIMEOUT_SECONDS=10

# =====================================================================
# S1 · БП-01 «Стартап до раунда» — приём заявок с Tilda (s1_intake, /s1/*)
# Пока S1_TILDA_WEBHOOK_KEY / S1_ADMIN_TOKEN не заданы, вебхук отвечает 503,
# тренажёр работает как раньше. БД — та же, таблица s1_readiness_jobs.
# =====================================================================
# Tilda → Настройки сайта → Формы → Webhook → API-ключ:
# имя = S1_TILDA_WEBHOOK_KEY_NAME, значение = S1_TILDA_WEBHOOK_KEY, передача в заголовке.
S1_TILDA_WEBHOOK_KEY_NAME=X-Webhook-Key
S1_TILDA_WEBHOOK_KEY=           # openssl rand -hex 32
S1_ADMIN_TOKEN=                 # openssl rand -hex 32 (≥24 символа); Authorization: Bearer <token>

S1_LLM_PROVIDER=openai          # openai | mock (dry-run без ключа; при APP_ENV=staging|production mock запрещён — ошибка при старте)
# TG-1: модель S1 по умолчанию зафиксирована в коде (LLM_MODEL_ID), temperature=0; OPENAI_MODEL её не меняет.
# MOS-7: для другого провайдера задать явно S1_LLM_MODEL_ID (напр. gpt://<folder_ID>/<model>).
S1_LLM_MODEL_ID=
OPENAI_BASE_URL=                # пусто = api.openai.com; общий для app.py и S1; Yandex: https://llm.api.cloud.yandex.net/v1
# По умолчанию json_object (для app.py раньше text.format не передавался). Для Yandex до проверки реальным вызовом ставить LLM_JSON_FORMAT=none.
LLM_JSON_FORMAT=json_object     # json_object | json_schema | none
S1_LLM_TIMEOUT_S=180

# Хосты, с которых разрешено скачивать файлы из формы (защита от SSRF).
# Проверить на тестовой заявке, какой домен отдаёт Tilda для загрузок.
S1_FILE_HOST_ALLOWLIST=ucarecdn.com,tupwidget.com,tildacdn.com
S1_MAX_FILE_MB=25
S1_MAX_DOC_CHARS=60000
S1_RETENTION_DAYS=90            # заявка и Readiness Pack удаляются из БД после срока

S1_FUND_NAME=Artgen Seed Fund
# TG-1: автоотправки фаундеру нет. Отправка — только POST /s1/jobs/<id>/approve с персональным токеном.
# Формат: имя:токен;имя2:токен2 (токен ≥24 символов). Реальные токены сюда НЕ класть.
S1_APPROVERS=
# HQ-035: роль подписанта факта «имя:роль;…» (роли — working_values.yaml fact_signoff.signer_roles; кто подписывает — G-13)
S1_APPROVER_ROLES=
S1_ANALYST_EMAILS=                  # через запятую
S1_SMTP_HOST=
S1_SMTP_PORT=587                    # 587 STARTTLS | 465 SSL
S1_SMTP_USER=
S1_SMTP_PASSWORD=
S1_SMTP_FROM=
S1_NOTIFY_WEBHOOK_URL=              # опц.: n8n/Make/Telegram; уходят только метаданные
# Q-316: кнопка «Сообщить о проблеме». Если задан — JSON обращения (с текстом) POST-ом на этот адрес, таймаут 5 с; пусто — только БД.
FEEDBACK_WEBHOOK_URL=

# =====================================================================
# HQ-018 · E-1 (docker compose, локальный Postgres, только синтетика)
# Реальные ключи сюда НЕ класть. По умолчанию compose берёт синтетические значения.
# =====================================================================
E1_DB_PASSWORD=change-me-local-only
# Для тестов против Postgres из хоста (порт 5433 проброшен только на 127.0.0.1):
HQ018_PG_URL=postgresql://trainer:change-me-local-only@127.0.0.1:5433/trainer_e1

# =====================================================================
# MOS-6 · закрытый staging (Yandex Cloud, ru-central1). Значения — ТОЛЬКО в Yandex Lockbox (ключи одного секрета)
# или в GitHub Environment `staging`; в репо и в tests.yml их нет. Здесь одни имена.
# APP_ENV=staging включает замок по сессии MOS-1 (#61); без любой из переменных ниже приложение не стартует.
# Вход (Google OAuth, сессия, RBAC) — модуль auth из #61; staging_guard своего OAuth не имеет.
# =====================================================================
APP_ENV=staging
# До решения юриста (#68) staging — только синтетика. false/0/no → приложение не стартует.
STAGING_SYNTHETIC_ONLY=true
DATABASE_URL=                   # Lockbox; Managed PostgreSQL, sslmode=require
GOOGLE_CLIENT_ID=               # Lockbox
GOOGLE_CLIENT_SECRET=           # Lockbox
SESSION_SECRET=                 # Lockbox; openssl rand -hex 32 (≥32 символов)
AUTH_ALLOWLIST=                 # Lockbox; формат #61: email:role[:scope], через запятую
AUTH_REDIRECT_URI=              # не секрет, env ревизии: https://<custom-domain>/auth/callback (имя из #61)
PUBLIC_BASE_URL=                # не секрет, env ревизии: https://<custom-domain>; обязателен при APP_ENV=staging (ссылки в пакете основателю)

# Деплой (deploy/yc/deploy.sh): идентификаторы облака. Только имена; значения — в GitHub Environment `staging` / у оператора.
# Секрет GitHub (Environment staging): YC_SA_KEY_JSON
# Идентификаторы: YC_FOLDER_ID, YC_REGISTRY_ID, YC_NETWORK_ID, YC_RUNTIME_SA_ID, YC_PG_CLUSTER_ID, LOCKBOX_SECRET_ID, AUTH_REDIRECT_URI, PUBLIC_BASE_URL
# LLM на staging (обязательно): deploy.sh ставит S1_LLM_PROVIDER=openai (mock на staging запрещён MOS-7) и берёт из Lockbox OPENAI_API_KEY и OPENAI_BASE_URL. Без них контейнер не стартует; OPENAI_BASE_URL пустой или api.openai.com на staging — ошибка при старте (только Yandex AI Studio).
