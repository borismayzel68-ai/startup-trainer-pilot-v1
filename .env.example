# =====================================================================
# Startup Trainer (существующий тренажёр)
# =====================================================================
OPENAI_API_KEY=                 # проектный ключ с лимитом расходов, не личный
OPENAI_MODEL=gpt-5.6
INVITE_CODE=
ADMIN_KEY=
SESSION_DATABASE_URL=           # на Render — PostgreSQL (или DATABASE_URL от Render)
SESSION_RETENTION_DAYS=30
TRAINER_EVENT_WEBHOOK=
WEBHOOK_TIMEOUT_SECONDS=10

# =====================================================================
# S1 · БП-01 «Стартап до раунда» — приём заявок с Tilda (s1_intake, /s1/*)
# Пока S1_TILDA_WEBHOOK_KEY / S1_ADMIN_TOKEN не заданы, вебхук отвечает 503,
# тренажёр работает как раньше. БД — та же, таблица s1_readiness_jobs.
# =====================================================================
# Tilda → Настройки сайта → Формы → Webhook → API-ключ:
# имя = S1_TILDA_WEBHOOK_KEY_NAME, значение = S1_TILDA_WEBHOOK_KEY, передача в заголовке.
S1_TILDA_WEBHOOK_KEY_NAME=X-Webhook-Key
S1_TILDA_WEBHOOK_KEY=           # openssl rand -hex 32
S1_ADMIN_TOKEN=                 # openssl rand -hex 32 (≥24 символа); Authorization: Bearer <token>

S1_LLM_PROVIDER=openai          # openai | mock (dry-run без ключа)
# TG-1: модель S1 по умолчанию зафиксирована в коде (LLM_MODEL_ID), temperature=0; OPENAI_MODEL её не меняет.
# MOS-7: для другого провайдера задать явно S1_LLM_MODEL_ID (напр. gpt://<folder_ID>/<model>).
S1_LLM_MODEL_ID=
OPENAI_BASE_URL=                # пусто = api.openai.com; общий для app.py и S1; Yandex: https://llm.api.cloud.yandex.net/v1
LLM_JSON_FORMAT=json_object     # json_object | json_schema | none
S1_LLM_TIMEOUT_S=180

# Хосты, с которых разрешено скачивать файлы из формы (защита от SSRF).
# Проверить на тестовой заявке, какой домен отдаёт Tilda для загрузок.
S1_FILE_HOST_ALLOWLIST=ucarecdn.com,tupwidget.com,tildacdn.com
S1_MAX_FILE_MB=25
S1_MAX_DOC_CHARS=60000
S1_RETENTION_DAYS=90            # заявка и Readiness Pack удаляются из БД после срока

S1_FUND_NAME=Artgen Seed Fund
# TG-1: автоотправки фаундеру нет. Отправка — только POST /s1/jobs/<id>/approve с персональным токеном.
# Формат: имя:токен;имя2:токен2 (токен ≥24 символов). Реальные токены сюда НЕ класть.
S1_APPROVERS=
# HQ-035: роль подписанта факта «имя:роль;…» (роли — working_values.yaml fact_signoff.signer_roles; кто подписывает — G-13)
S1_APPROVER_ROLES=
S1_ANALYST_EMAILS=                  # через запятую
S1_SMTP_HOST=
S1_SMTP_PORT=587                    # 587 STARTTLS | 465 SSL
S1_SMTP_USER=
S1_SMTP_PASSWORD=
S1_SMTP_FROM=
S1_NOTIFY_WEBHOOK_URL=              # опц.: n8n/Make/Telegram; уходят только метаданные

# =====================================================================
# HQ-018 · E-1 (docker compose, локальный Postgres, только синтетика)
# Реальные ключи сюда НЕ класть. По умолчанию compose берёт синтетические значения.
# =====================================================================
E1_DB_PASSWORD=change-me-local-only
# Для тестов против Postgres из хоста (порт 5433 проброшен только на 127.0.0.1):
HQ018_PG_URL=postgresql://trainer:change-me-local-only@127.0.0.1:5433/trainer_e1
